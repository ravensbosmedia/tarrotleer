[Unit]
Description=Tarrot Leerplatform Server (Mystieke Kaarten)
After=network.target tarrot-kerykeion.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tarrotleer
ExecStart=/usr/bin/node node_modules/.bin/tsx server.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/ubuntu/tarrotleer/.env

[Install]
WantedBy=multi-user.target
